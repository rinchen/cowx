api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.46826db6d1e97a725b85504d8a9426472b687ccb.001.1"},{"event":"Hydrologic Outlook","headline":"Hydrologic Outlook issued October 9 at 10:53AM MDT by NWS Grand Junction CO","description":"ESFGJT\n\nA strong low pressure system off the Pacific Coast will begin to draw\nin tropical moisture associated with Topical Storm Rachel this\nweekend. This strong southerly fetch will draw anomalously high\nmoisture content across the Desert Southwest and into eastern Utah\nand western Colorado. The chance for widespread precipitation\nincreases Saturday evening into Sunday. Total precipitation forecasts\nrange from 1 to 3 inches across high terrain, with highest amounts\nfavoring the Uintas, Tavaputs and the Southwest San Juan mountains.\n\nEmbedded thunderstorms are also possible Sunday afternoon, increasing\nthe threat for flash flooding across vulnerable terrain. While\nconfidence in location and rainfall rates remain low at this time,\nthe potential for rapidly rising rivers, streams, normally dry\narroyos and slot canyons are possible Sunday through Monday.\n\nPlease follow the evolving forecast, especially if your plans\nincluding recreating or commuting across eastern Utah and western\nColorado Sunday onward. Also, keep in mind weather potential above\nyour location and upstream, particularly for those who reside below\nsensitive terrain like recent burn scars.","ends":"2026-10-12T18:00:00-06:00","severity":"Unknown","areaDesc":"Archuleta, CO; Delta, CO; Dolores, CO; Garfield, CO; Hinsdale, CO; La Plata, CO; Mesa, CO; Moffat, CO; Montezuma, CO; Montrose, CO; Ouray, CO; Rio Blanco, CO; San Juan, CO; San Miguel, CO; Daggett, UT; Grand, UT; San Juan, UT; Uintah, UT","id":"urn:oid:2.49.0.1.840.0.5953c0ab1d0bcab0b29fc3e9364e3d17cf28daf6.001.1","url":"https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.5953c0ab1d0bcab0b29fc3e9364e3d17cf28daf6.001.1"}],"afd":{"office":"GJT","issued":"2026-10-11T06:00:00+00:00","snippet":"000 FXUS65 KGJT 110600 AFDGJT Area Forecast Discussion National Weather Service Grand Junction CO 1200 AM MDT Sun Oct 11 2026 .KEY MESSAGES... - Deep moisture continues through the weekend as remnants of tropical system Rachel move through the region, especially overnight and through Sunday. Rainfall totals of 2-3 inches are possible over the eastern Utah mountains and 1-2 inches across the San Ju","url":"https://forecast.weather.gov/product.php?site=GJT&issuedby=GJT&product=AFD&format=CI"},"hwo":null,"fwf":{"office":"GJT","issued":"2026-10-10T18:54:00+00:00","snippet":".DISCUSSION...Moisture from the remnants of Tropical Storm Rachel will move into the area today through Sunday. Wetting rains are expected to develop with more widespread showers this evening through Sunday morning. Strong winds and potential for strong to severe storms arrive Sunday afternoon and evening. Heavy rain, small hail and strong winds are concerns for Sunday with flash flooding possible","url":"https://forecast.weather.gov/product.php?site=GJT&issuedby=GJT&product=FWF&format=CI"},"coagmet":{"station_id":"nuc01","station_name":"Nucla","distance_km":5.6,"soil_temp_5cm_f":-999,"soil_temp_15cm_f":-999,"soil_moisture_5cm":null,"soil_moisture_15cm":null,"precip_in":null,"eto_in":null,"vapor_pressure":null,"solar_radiation":-999,"wind_speed_mph":-999,"air_temp_f":53.02,"relative_humidity":0.986,"url":"https://coagmet.colostate.edu/station/nuc01"},"aviation":{"icao":"KMTJ","distance_km":0,"raw_metar":"METAR KMTJ 110553Z AUTO 23004KT 10SM BKN120 12/11 A3001 RMK AO2 RAE04 SLP097 P0000 60006 T01220111 10183 20122 58004","temp_f":54,"wind_dir":230,"wind_kt":4,"gust_kt":null,"visibility":"10+","cover":"BKN","flight_category":"VFR","altimeter":1016.3,"observed":1791697980,"raw_taf":"TAF KMTJ 110540Z 1106/1206 10006KT P6SM -SHRA SCT040 OVC060 TEMPO 1106/1110 4SM -SHRA BR BKN035 OVC050 FM111000 14008KT P6SM VCSH OVC045 PROB30 1110/1114 4SM -SHRA BR BKN030 OVC050 FM111900 20012G22KT P6SM VCSH FEW050 SCT080 PROB30 1120/1