ifts and up to 15-minute delays. Crews will switch two-way traffic into the eastbound lanes, perform temporary striping operations and begin asphalt milling in the westbound lanes. Parking will not be permitted on US 160 and vehicles will be towed at the owner's expense. Westbound lane closures, 10’ width and 75’ length restrictions will remain in place 24/7 through end of 2026. Work is weather-dependent. For questions contact the project team at 970-335-9230 or Pagosa160reconstruction@gmail.com Project Webpage: www.codot.gov/projects/us160pagosasprings","impact":null,"roads":"US-160W","lat":37.272958,"lon":-107.036952,"chain_law":false,"closure":false,"pass_relevant":false,"observed":"2026-10-16T13:03:36.699Z","start_time":"2026-10-24T13:00:00Z","clear_time":"2026-10-25T00:00:00Z","category":"Construction","severity":null,"source":"planned","geometry_kind":"point","distance_km":55.6}]},"cwop":{"callsign":"KY0TEQ-13","lat":37.206,"lon":-107.787167,"temp_f":48,"humidity":76,"pressure_mb":1303.9,"wind_speed_mph":4,"wind_gust_mph":6,"wind_dir_deg":356,"observed":"2026-10-24T03:36:03Z","distance_km":17},"pws":{"primary":{"callsign":"KY0TEQ-13","network":"CWOP/APRS","lat":37.206,"lon":-107.787167,"temp_f":48,"humidity":76,"pressure_mb":1303.9,"wind_speed_mph":4,"wind_gust_mph":6,"wind_dir_deg":356,"observed":"2026-10-24T03:36:03Z","distance_km":17},"nearby":[{"callsign":"KC0OOO-WX","network":"CWOP/APRS","lat":37.265167,"lon":-107.029667,"temp_f":45,"humidity":89,"pressure_mb":1022.4,"wind_speed_mph":0,"wind_gust_mph":10,"wind_dir_deg":309,"observed":"2026-10-24T03:27:51Z","distance_km":56}],"links":{"aprs":"https://aprs.fi/#!call=a%2FKY0TEQ-13","wunderground":null}},"hms_smoke":{"density":"none","observed":"2026-10-23","sourceUrl":"https://satepsanone.nesdis.noaa.gov/pub/FIRE/web/HMS/Smoke_Polygons/Shapefile/2026/10/hms_smoke20261023.zip"},"fire_weather":{"day1":{"windRh":"none","dryT":"none","valid":null,"expire":null,"issue":null},"day2":{"windRh":"none","dryT":"none",