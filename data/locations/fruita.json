/urn:oid:2.49.0.1.840.0.ff10900cc46e41ab81af8f49e488159758748f34.001.1"},{"event":"Hydrologic Outlook","headline":"Hydrologic Outlook issued October 9 at 10:53AM MDT by NWS Grand Junction CO","description":"ESFGJT\n\nA strong low pressure system off the Pacific Coast will begin to draw\nin tropical moisture associated with Topical Storm Rachel this\nweekend. This strong southerly fetch will draw anomalously high\nmoisture content across the Desert Southwest and into eastern Utah\nand western Colorado. The chance for widespread precipitation\nincreases Saturday evening into Sunday. Total precipitation forecasts\nrange from 1 to 3 inches across high terrain, with highest amounts\nfavoring the Uintas, Tavaputs and the Southwest San Juan mountains.\n\nEmbedded thunderstorms are also possible Sunday afternoon, increasing\nthe threat for flash flooding across vulnerable terrain. While\nconfidence in location and rainfall rates remain low at this time,\nthe potential for rapidly rising rivers, streams, normally dry\narroyos and slot canyons are possible Sunday through Monday.\n\nPlease follow the evolving forecast, especially if your plans\nincluding recreating or commuting across eastern Utah and western\nColorado Sunday onward. Also, keep in mind weather potential above\nyour location and upstream, particularly for those who reside below\nsensitive terrain like recent burn scars.","ends":"2026-10-12T18:00:00-06:00","severity":"Unknown","areaDesc":"Archuleta, CO; Delta, CO; Dolores, CO; Garfield, CO; Hinsdale, CO; La Plata, CO; Mesa, CO; Moffat, CO; Montezuma, CO; Montrose, CO; Ouray, CO; Rio Blanco, CO; San Juan, CO; San Miguel, CO; Daggett, UT; Grand, UT; San Juan, UT; Uintah, UT","id":"urn:oid:2.49.0.1.840.0.5953c0ab1d0bcab0b29fc3e9364e3d17cf28daf6.001.1","url":"https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.5953c0ab1d0bcab0b29fc3e9364e3d17cf28daf6.001.1"}],"afd":{"office":"GJT","issued":"2026-10-10T23:52:00+00:00","snippet":"000 FXUS65 KGJT 102352 AFDGJT Area Forecast Discussion National Weather Service Grand Junction CO 552 PM MDT Sat Oct 10 2026 .KEY MESSAGES... - Moisture increases this weekend as remnants of tropical system Rachel move through the region, especially this evening through Sunday. Rainfall totals of 1-2 inches and locally higher are possible over the eastern Utah mountains and the San Juans. Moderate","url":"https://forecast.weather.gov/product.php?site=GJT&issuedby=GJT&product=AFD&format=CI"},"hwo":null,"fwf":{"office":"GJT","issued":"2026-10-10T18:54:00+00:00","snippet":".DISCUSSION...Moisture from the remnants of Tropical Storm Rachel will move into the area today through Sunday. Wetting rains are expected to develop with more widespread showers this evening through Sunday morning. Strong winds and potential for strong to severe storms arrive Sunday afternoon and evening. Heavy rain, small hail and strong winds are concerns for Sunday with flash flooding possible","url":"https://forecast.weather.gov/product.php?site=GJT&issuedby=GJT&product=FWF&format=CI"},"coagmet":{"station_id":"frt03","station_name":"CSU Fruita Exp Station","distance_km":3.8,"soil_temp_5cm_f":66.33,"soil_temp_15cm_f":66.9,"soil_moisture_5cm":null,"soil_moisture_15cm":null,"precip_in":null,"eto_in":null,"vapor_pressure":null,"solar_radiation":0,"wind_speed_mph":4.18,"air_temp_f":57.9,"relative_humidity":0.91,"url":"https://coagmet.colostate.edu/station/frt03"},"aviation":{"icao":"KGJT","distance_km":0,"raw_metar":"METAR KGJT 110053Z VRB03KT 10SM -RA BKN075 OVC085 15/12 A2992 RMK AO2 RAE09B44 SLP081 P0000 T01500122","temp_f":59,"wind_dir":"VRB","wind_kt":3,"gust_kt":null,"visibility":"10+","cover":"OVC","flight_category":"VFR","altimeter":1013.3,"observed":1791679980,"raw_taf":"TAF KGJT 110031Z 1101/1124 36010KT P6SM VCSH SCT080 BKN090 PROB30 1101/1102 5SM SHRA BR BKN060 FM110200 11012KT P6SM VCSH SCT050 BKN060 PROB30 1102/1104 4SM -SHRA BKN050 FM110400 10013KT 6SM -SHRA SCT040 OVC050 PROB30 1104/1110 3SM -SHRA BR BKN035 OVC040 FM111