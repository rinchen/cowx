ps://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.ff10900cc46e41ab81af8f49e488159758748f34.001.1"},{"event":"Hydrologic Outlook","headline":"Hydrologic Outlook issued October 9 at 10:53AM MDT by NWS Grand Junction CO","description":"ESFGJT\n\nA strong low pressure system off the Pacific Coast will begin to draw\nin tropical moisture associated with Topical Storm Rachel this\nweekend. This strong southerly fetch will draw anomalously high\nmoisture content across the Desert Southwest and into eastern Utah\nand western Colorado. The chance for widespread precipitation\nincreases Saturday evening into Sunday. Total precipitation forecasts\nrange from 1 to 3 inches across high terrain, with highest amounts\nfavoring the Uintas, Tavaputs and the Southwest San Juan mountains.\n\nEmbedded thunderstorms are also possible Sunday afternoon, increasing\nthe threat for flash flooding across vulnerable terrain. While\nconfidence in location and rainfall rates remain low at this time,\nthe potential for rapidly rising rivers, streams, normally dry\narroyos and slot canyons are possible Sunday through Monday.\n\nPlease follow the evolving forecast, especially if your plans\nincluding recreating or commuting across eastern Utah and western\nColorado Sunday onward. Also, keep in mind weather potential above\nyour location and upstream, particularly for those who reside below\nsensitive terrain like recent burn scars.","ends":"2026-10-12T18:00:00-06:00","severity":"Unknown","areaDesc":"Archuleta, CO; Delta, CO; Dolores, CO; Garfield, CO; Hinsdale, CO; La Plata, CO; Mesa, CO; Moffat, CO; Montezuma, CO; Montrose, CO; Ouray, CO; Rio Blanco, CO; San Juan, CO; San Miguel, CO; Daggett, UT; Grand, UT; San Juan, UT; Uintah, UT","id":"urn:oid:2.49.0.1.840.0.5953c0ab1d0bcab0b29fc3e9364e3d17cf28daf6.001.1","url":"https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.5953c0ab1d0bcab0b29fc3e9364e3d17cf28daf6.001.1"}],"afd":{"office":"GJT","issued":"2026-10-10T17:52:00+00:00","snippet":"000 FXUS65 KGJT 101752 AFDGJT Area Forecast Discussion National Weather Service Grand Junction CO 1152 AM MDT Sat Oct 10 2026 .KEY MESSAGES... - Moisture increases this weekend as remnants of tropical system Rachel move through the region, especially this evening through Sunday. Rainfall totals of 1-2 inches and locally higher are possible over the eastern Utah mountains and the San Juans. Moderat","url":"https://forecast.weather.gov/product.php?site=GJT&issuedby=GJT&product=AFD&format=CI"},"hwo":null,"fwf":{"office":"GJT","issued":"2026-10-10T18:54:00+00:00","snippet":".DISCUSSION...Moisture from the remnants of Tropical Storm Rachel will move into the area today through Sunday. Wetting rains are expected to develop with more widespread showers this evening through Sunday morning. Strong winds and potential for strong to severe storms arrive Sunday afternoon and evening. Heavy rain, small hail and strong winds are concerns for Sunday with flash flooding possible","url":"https://forecast.weather.gov/product.php?site=GJT&issuedby=GJT&product=FWF&format=CI"},"coagmet":{"station_id":"ctz01","station_name":"Cortez","distance_km":5.4,"soil_temp_5cm_f":61.03,"soil_temp_15cm_f":60.1,"soil_moisture_5cm":null,"soil_moisture_15cm":null,"precip_in":null,"eto_in":null,"vapor_pressure":null,"solar_radiation":87.1,"wind_speed_mph":7.39,"air_temp_f":68.97,"relative_humidity":0.414,"url":"https://coagmet.colostate.edu/station/ctz01"},"aviation":{"icao":"KCEZ","distance_km":0,"raw_metar":"METAR KCEZ 102253Z AUTO 17017G25KT 10SM SCT070 BKN080 21/06 A2994 RMK AO2 LTG DSNT S AND NW SLP079 T02060061","temp_f":69,"wind_dir":170,"wind_kt":17,"gust_kt":25,"visibility":"10+","cover":"BKN","flight_category":"VFR","altimeter":1014,"observed":1791672780,"raw_taf":null,"url":"https://aviationweather.gov/data/metar/?ids=KCEZ&hours=0"},"airgradient":null,"airnow":null,"openmeteo_aq":{"pm25":1.7,"pm10":2.2,"co":109,"no2":0.7,"so2":0.4,"o3":87,"european_aqi":34,"us_aqi":41,"time":"2026-10-10T17:00"},"usgs":