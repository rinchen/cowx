 begin asphalt milling in the westbound lanes. Parking will not be permitted on US 160 and vehicles will be towed at the owner's expense. Westbound lane closures, 10’ width and 75’ length restrictions will remain in place 24/7 through end of 2026. Work is weather-dependent. For questions contact the project team at 970-335-9230 or Pagosa160reconstruction@gmail.com Project Webpage: www.codot.gov/projects/us160pagosasprings","impact":null,"roads":"US-160W","lat":37.272958,"lon":-107.036952,"chain_law":false,"closure":false,"pass_relevant":false,"observed":"2026-09-30T13:05:09.637Z","start_time":"2026-10-08T13:00:00Z","clear_time":"2026-10-09T00:00:00Z","category":"Construction","severity":null,"source":"planned","geometry_kind":"point","distance_km":73.6}]},"cwop":null,"pws":null,"hms_smoke":{"density":"none","observed":"2026-10-06","sourceUrl":"https://satepsanone.nesdis.noaa.gov/pub/FIRE/web/HMS/Smoke_Polygons/Shapefile/2026/10/hms_smoke20261006.zip"},"fire_weather":{"day1":{"windRh":"none","dryT":"none","valid":"2026-10-07T12:00:00+00:00","expire":"2026-10-08T12:00:00+00:00","issue":"2026-10-07T04:47:00+00:00"},"day2":{"windRh":"none","dryT":"none","valid":"2026-10-08T12:00:00+00:00","expire":"2026-10-09T12:00:00+00:00","issue":"2026-10-07T04:48:00+00:00"},"sourceUrl":"https://www.spc.noaa.gov/products/fire_wx/overview.html"},"nearby_fires":{"incidents":[{"name":"Elk","acres":7257,"percentContained":90,"lat":38.124188,"lon":-107.354823,"updated":"2026-07-09T15:46:12.000Z","url":"https://inciweb.wildfire.gov/incident-information/search?query=Elk","distance_km":25.5},{"name":"Gold Mountain","acres":39747,"percentContained":92,"lat":38.032853,"lon":-107.66402,"updated":"2026-06-27T23:33:00.000Z","url":"https://inciweb.wildfire.gov/incident-information/search?query=Gold%20Mountain","distance_km":34},{"name":"Swiss Roll","acres":777,"percentContained":100,"lat":37.514815,"lon":-106.790543,"updated":"2026-08-20T14:33:00.000Z","url":"https://inciweb.wildfire.gov/incident-