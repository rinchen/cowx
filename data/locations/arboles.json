46:07.404Z","start_time":"2026-11-02T02:00:00Z","clear_time":"2026-11-02T14:00:00Z","category":"Construction","severity":null,"source":"planned","geometry_kind":"point","distance_km":44.2},{"id":"OpenTMS-Event35931520792","title":"US 160 Pagosa Springs Reconstruction-147606","type":"Road Construction","description":"Between US 84 and Pike Drive (Pagosa Springs) from Mile Point 144.3 to Mile Point 141.8. Road construction. Starting October 31, 2026 at 7:00AM MDT until October 31, 2026 at about 6:00PM MDT. Full schedule below: • October 31, 7:00AM - October 31, 6:00PM Comment: Harman Park & Piedra Road-Work is underway at this intersection of US 160. Working hours will be intermittent day and night so motorists should plan for potential delays, Monday-Saturday. Please allow extra time to get through the work zone. Safety benefits of this work includes pedestrian safety upgrades and ADA accessibility improvements. Expect lane shifts and up to 15-minute delays. Crews will switch two-way traffic into the eastbound lanes, perform temporary striping operations and begin asphalt milling in the westbound lanes. Parking will not be permitted on US 160 and vehicles will be towed at the owner's expense. Westbound lane closures, 10’ width and 75’ length restrictions will remain in place 24/7 through end of 2026. Work is weather-dependent. For questions contact the project team at 970-335-9230 or Pagosa160reconstruction@gmail.com Project Webpage: www.codot.gov/projects/us160pagosasprings","impact":null,"roads":"US-160W","lat":37.272958,"lon":-107.036952,"chain_law":false,"closure":false,"pass_relevant":false,"observed":"2026-10-23T13:03:35.227Z","start_time":"2026-10-31T13:00:00Z","clear_time":"2026-11-01T00:00:00Z","category":"Construction","severity":null,"source":"planned","geometry_kind":"point","distance_km":44},{"id":"OpenTMS-Event36072336453","title":"Paving Operations-150998","type":"Paving Operations","description":"Between Frontage Road and County Road 232 (near Durango) from Mile Point 88 to Mile Point 89.5. Paving operations. Alternating traffic. Starting Sunday at 7:00PM MDT until Monday, at about 7:00AM MDT. Full schedule below: • November 1, 7:00PM - November 2, 7:00AM Comment: The US 550-US 160 Grandview Interchange exit and entrance ramps will experience staggered nighttime closures from7 p.m. to 7 a.m., Sunday night through Friday morning. Motorists traveling southbound and northbound on US 550 between Durango and New Mexico will detour on Wilson Gulch Drive and Three Springs Boulevard to access the Grandview Bridge and points beyond. For more information email: resurfacingproject@gmail.com.","impact":null,"roads":"US-160E","lat":37.219398,"lon":-107.851293,"chain_law":false,"closure":false,"pass_relevant":false,"observed":"2026-10-30T16:46:11.117Z","start_time":"2026-11-02T02:00:00Z","clear_time":"2026-11-02T14:00:00Z","category":"Construction","severity":null,"source":"planned","geometry_kind":"point","distance_km":44.2}]},"cwop":{"callsign":"KY0TEQ-13","lat":37.206,"lon":-107.787167,"temp_f":56,"humidity":54,"pressure_mb":1306.5,"wind_speed_mph":3,"wind_gust_mph":7,"wind_dir_deg":151,"observed":"2026-10-31T22:57:21Z","distance_km":38.6},"pws":{"primary":{"callsign":"KY0TEQ-13","network":"CWOP/APRS","lat":37.206,"lon":-107.787167,"temp_f":56,"humidity":54,"pressure_mb":1306.5,"wind_speed_mph":3,"wind_gust_mph":7,"wind_dir_deg":151,"observed":"2026-10-31T22:57:21Z","distance_km":38.6},"nearby":[{"callsign":"KC0OOO-WX","network":"CWOP/APRS","lat":37.265167,"lon":-107.029667,"temp_f":56,"humidity":56,"pressure_mb":1024,"wind_speed_mph":1,"wind_gust_mph":7,"wind_dir_deg":334,"observed":"2026-10-31T23:02:42Z","distance_km":44}],"links":{"aprs":"https://aprs.fi/#!call=a%2FKY0TEQ-13","wunderground":null}},"hms_smoke":{"density":"none","observed":"2026-10-31","sourceUrl":"https://satepsanone.nesdis.noaa.gov/pub/FIRE/web/HMS/Smoke_Polygons/Shapefile/2026/10/hms_smoke20261031.zip"},"fire_weather":{"day1":{"windRh":"none","dryT":"n