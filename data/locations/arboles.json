ood","ends":"2026-09-25T06:00:00-06:00","severity":"Severe","areaDesc":"Southwest San Juan Mountains; San Juan River Basin","id":"urn:oid:2.49.0.1.840.0.c86447dd54a169ae9df7d6c5b6b9b0c629575548.002.1","url":"https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.c86447dd54a169ae9df7d6c5b6b9b0c629575548.002.1"}],"afd":{"office":"GJT","issued":"2026-09-22T19:48:00+00:00","snippet":"000 FXUS65 KGJT 221948 AFDGJT Area Forecast Discussion National Weather Service Grand Junction CO 148 PM MDT Tue Sep 22 2026 .KEY MESSAGES... - Wetter weather returns to the region today, with showers and storms possible each day through the end of the work week. - There is a potential for moderate and heavy rainfall that could lead to flooding mainly in the southern San Juans and surrounding vall","url":"https://forecast.weather.gov/product.php?site=GJT&issuedby=GJT&product=AFD&format=CI"},"hwo":null,"fwf":{"office":"GJT","issued":"2026-09-22T19:54:00+00:00","snippet":".DISCUSSION...Moisture returns today with increased chances for showers and thunderstorms. The best chances for wetting rains will be over the central and southern Colorado mountains, but any higher terrain will see the possibility for a shower or thunderstorm. Precip chances and increased relative humidity continues through week keeping critical fire weather conditions at a minimum. ...GUSTY ERRA","url":"https://forecast.weather.gov/product.php?site=GJT&issuedby=GJT&product=FWF&format=CI"},"coagmet":{"station_id":"ign02","station_name":"Ignacio 2","distance_km":16.1,"soil_temp_5cm_f":-999,"soil_temp_15cm_f":-999,"soil_moisture_5cm":null,"soil_moisture_15cm":null,"precip_in":null,"eto_in":null,"vapor_pressure":null,"solar_radiation":-999,"wind_speed_mph":-999,"air_temp_f":71.42,"relative_humidity":0.446,"url":"https://coagmet.colostate.edu/station/ign02"},"aviation":{"icao":"KPSO","distance_km":0,"raw_metar":"METAR KPSO 222015Z AUTO 13008KT 10SM BKN100 BKN120 20/07 A3031 RMK AO2","temp_f":68,"wind_dir":130,"wind_kt":8,"gust_k