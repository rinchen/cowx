,0.032,0.031,0.035,0.119,0.066,0.076,0.036,0.022,0.036,0.042,0.052,0.055,0.051,0.072,0.084,0.04,0.099,0.041,0.046,0.008,0.061,0.127,0.112,0.065,0.075,0.041,0.094,0.014,0.014,0.055,0.032,0.02,0.052,0.054,0.072,0.062,0.04,0.141,0.116,0.05,0.035,0.064,0.038,0.058,0.047,0.062,0.028,0.053,0.089,0.019,0.035,0.03,0.051,0.06,0.066,0.049,0.04,0.092,0.043,0.046,0.085,0.023,0.022,0.041,0.062,0.054,0.037,0.098,0.046,0.066,0.026,0.063,0.042,0.047,0.045,0.028,0.041,0.057,0.026,0.054,0.049,0.061,0.047,0.028,0.05,0.042,0.041,0.075,0.057,0.048,0.031,0.038,0.047,0.076,0.08,0.081,0.074,0.024,0.07,0.021,0.019,0.071,0.031,0.03,0.022]}},"alerts":[{"event":"Wind Advisory","headline":"Wind Advisory issued October 10 at 9:57PM MDT until October 12 at 12:00AM MDT by NWS Grand Junction CO","description":"* WHAT...South winds 20 to 30 mph with gusts up to 50 mph expected.\n\n* WHERE...In Colorado, Four Corners/Upper Dolores River and Paradox\nValley/Lower Dolores River. In Utah, Arches/Grand Flat,\nCanyonlands/Natural Bridges, and Southeast Utah.\n\n* WHEN...From 9 AM Sunday to midnight MDT Sunday Night.\n\n* IMPACTS...Gusty winds will blow around unsecured objects. Tree\nlimbs could be blown down and a few power outages may result.\n\n* ADDITIONAL DETAILS...In addition to strong surface winds expected,\nstronger thunderstorm potential could result in locally higher wind\ngusts at times.","ends":"2026-10-12T00:00:00-06:00","severity":"Moderate","areaDesc":"Paradox Valley/Lower Dolores River; Four Corners/Upper Dolores River; Southeast Utah; Arches/Grand Flat; Canyonlands/Natural Bridges","id":"urn:oid:2.49.0.1.840.0.46826db6d1e97a725b85504d8a9426472b687ccb.001.1","url":"https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.46826db6d1e97a725b85504d8a9426472b687ccb.001.1"},{"event":"Hydrologic Outlook","headline":"Hydrologic Outlook issued October 9 at 10:53AM MDT by NWS Grand Junction CO","description":"ESFGJT\n\nA strong low pressure system off the Pacific Coast will begin to draw\nin tropical moisture associated with Topical Storm Rachel this\nweekend. This strong southerly fetch will draw anomalously high\nmoisture content across the Desert Southwest and into eastern Utah\nand western Colorado. The chance for widespread precipitation\nincreases Saturday evening into Sunday. Total precipitation forecasts\nrange from 1 to 3 inches across high terrain, with highest amounts\nfavoring the Uintas, Tavaputs and the Southwest San Juan mountains.\n\nEmbedded thunderstorms are also possible Sunday afternoon, increasing\nthe threat for flash flooding across vulnerable terrain. While\nconfidence in location and rainfall rates remain low at this time,\nthe potential for rapidly rising rivers, streams, normally dry\narroyos and slot canyons are possible Sunday through Monday.\n\nPlease follow the evolving forecast, especially if your plans\nincluding recreating or commuting across eastern Utah and western\nColorado Sunday onward. Also, keep in mind weather potential above\nyour location and upstream, particularly for those who reside below\nsensitive terrain like recent burn scars.","ends":"2026-10-12T18:00:00-06:00","severity":"Unknown","areaDesc":"Archuleta, CO; Delta, CO; Dolores, CO; Garfield, CO; Hinsdale, CO; La Plata, CO; Mesa, CO; Moffat, CO; Montezuma, CO; Montrose, CO; Ouray, CO; Rio Blanco, CO; San Juan, CO; San Miguel, CO; Daggett, UT; Grand, UT; San Juan, UT; Uintah, UT","id":"urn:oid:2.49.0.1.840.0.5953c0ab1d0bcab0b29fc3e9364e3d17cf28daf6.001.1","url":"https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.5953c0ab1d0bcab0b29fc3e9364e3d17cf28daf6.001.1"}],"afd":{"office":"BOU","issued":"2026-10-11T06:08:00+00:00","snippet":"000 FXUS65 KBOU 110608 AFDBOU Area Forecast Discussion National Weather Service Denver/Boulder CO 1208 AM MDT Sun Oct 11 2026 .KEY MESSAGES... - Another unseasonably warm and mostly dry day expected Sunday. - Isolated to scatteredshowers (15-35% coverage) and a couple weak storms over themountains possible again Sunday afternoon. Any precipitation would be light. - Pattern change next week, with c","url":"https://forecast.weather.gov/product.php?site=BOU&issuedby=BOU&product=AFD&format=CI"},"hwo":null,"fwf":{"office":"BOU","issued":"2026-10-11T08:35:00+00:00","snippet":".DISCUSSION...Today through Thursday... An increase in moisture will keep high clouds over the region through most of today although the majority of the area should remain dry. There will be a 20% chance for showers and perhaps a few lightning strikes over the high terrain, with a near-zero chance for wetting rain. Any showers that develop will be able to produce erratic wind gusts up to 30 mph. O","url":"https://forecast.weather.gov/product.php?site=BOU&issuedby=BOU&product=FWF&format=CI"},"coagmet":{"station_id":"gby01","station_name":"Granby","distance_km":19.3,"soil_temp_5cm_f":48.7,"soil_temp_15cm_f":52.45,"soil_moisture_5cm":null,"soil_moisture_15cm":null,"precip_in":null,"eto_in":null,"vapor_pressure":null,"solar_radiation":0,"wind_speed_mph":0.27,"air_temp_f":43.81,"relative_humidity":0.845,"url":"https://coagmet.colostate.edu/station/gby01"},"aviation":{"icao":"KAEJ","distance_km":0,"raw_metar":"METAR KAEJ 110915Z AUTO 12005KT 10SM OVC080 11/03 A3004 RMK AO2 T01130030","temp_f":52,"wind_dir":120,"wind_kt":5,"gust_kt":null,"visibility":"10+","cover":"OVC","flight_category":"VFR","altimeter":1017.4,"observed":1791710100,"raw_taf":null,"url":"https://aviationweather.gov/data/metar/?ids=KAEJ&hours=0"},"airgradient":{"pm25":1,"aqi_pm25":4,"sensor_count":1,"distance_km":22.8,"max_distance_km":22.8,"name":"Granby CO","url":"https://www.airgradient.com/","sensors":[{"name":"Granby CO","distance_km":22.8,"pm25":1}],"humidity":23,"temperature_f":75},"airnow":null,"openmeteo_aq":{"pm25":1.3,"pm10":2.1,"co":111,"no2":1.7,"so2":0.2,"o3":69,"european_aqi":25,"us_aqi":35,"time":"2026-10-11T03:00"},"usgs":{"station_id":"09014050","station_name":"GRAND LAKE OUTLET BLW CHIPMUNK LN AT GRAND LK, CO","distance_km":0.8,"discharge_cfs":-151,"