,0.016,0.049,0.032,0.065,0.037,0.052,0.073,0.051,0.093,0.068,0.069,0.033,0.043,0.11,0.093,0.073,0.047,0.043,0.066,0.009,0.007,0.057,0.025,0.028,0.034,0.074,0.068,0.042,0.025,0.106,0.082,0.023,0.055,0.059,0.044,0.047,0.021,0.081,0.044,0.053,0.077,0.006,0.009,0.06,0.086,0.072,0.05,0.037,0.089,0.112,0.049,0.077,0.088,0.013,0.009,0.028,0.081,0.083,0.059,0.087,0.051,0.055,0.077,0.095,0.046,0.067,0.059,0.055,0.072,0.046,0.026,0.046,0.137,0.132,0.047,0.032,0.067,0.064,0.08,0.109,0.075,0.077,0.078,0.065,0.072,0.068,0.115,0.145,0.06,0.038,0.104,0.054,0.043,0.025,0.094,0.073,0.04]}},"alerts":[{"event":"Hydrologic Outlook","headline":"Hydrologic Outlook issued September 25 at 2:21PM MDT by NWS Grand Junction CO","description":"ESFGJT\n\nIn the wake of today's precipitation, our attention will turn to the\nEastern Pacific. Tropical moisture is anticipated to spread across\nthe Desert Southwest early next week, drawing moisture from a pair of\nHurricanes; Odalys and Polo. The forecast becomes increasing complex\ndue to a closed low currently forecast to drive across the Southwest\nCONUS as Hurricane Polo approaches the Baja California Peninsula.\nStrong southerly winds ahead of the low are expected to pull tropical\nmoisture towards eastern Utah and western Colorado as early as Monday\nmorning. The challenge and uncertainty in our precipitation forecast\nincrease as the week progresses and the low traverses our southern\nStates. Excessive rainfall is most probable over AZ and NM, attm, but\nthe northerly extent poses a threat to our southern San Juan river\nbasins. Current forecasts suggests 1 to 3 inches of rain over Monday\nmorning through Wednesday. At face value, rivers and tributaries will\nsee a bump up due to said moisture. However, localized heavier\namounts could result in minor flooding across the southern San Juan\nfoothills and communities further downstream.\n\nRivers have responded rapidly to recent rainfall due to saturated\nsoils and increased runoff potential. Thus, prolonged periods of\nadditional rainfall over these regions would trigger a similar\nresponse. The current precipitation forecast suggests larger peaks in\nseveral creeks and rivers than what has been observed over the\nprevious 7 days. However, high end probabilistic rainfall amounts\n(i.e. above 90th percentile) may lead to rivers exceeding action\nstage to minor flooding. Most probable basins to see significant\nrises include; the Rio Blanco, San Juan, Piedra, Los Pinos/Vallecito\nCreek, and the Animas River Basins.\n\nConvective storms and periods of heavy rainfall fed from said\ntropical moisture could result in localized flooding impacts across\nthe CWA, however, confidence decreases rapidly north of the San\nJuans. Please continue to monitor the forecast as these systems\nevolve. Especially for those who reside and/or plan to recreate in\nthe southwest quadrant of the forecast area.","ends":"2026-09-30T06:00:00-06:00","severity":"Unknown","areaDesc":"Archuleta, CO; Dolores, CO; Gunnison, CO; Hinsdale, CO; La Plata, CO; Montezuma, CO; Ouray, CO; San Juan, CO; San Miguel, CO; Grand, UT; San Juan, UT","id":"urn:oid:2.49.0.1.840.0.ce67801ec73048f07c44dd0418c6a50edd1c8fdc.001.1","url":"https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.ce67801ec73048f07c44dd0418c6a50edd1c8fdc.001.1"}],"afd":{"office":"GJT","issued":"2026-09-26T05:24:00+00:00","snippet":"000 FXUS65 KGJT 260524 AFDGJT Area Forecast Discussion National Weather Service Grand Junction CO 1124 PM MDT Fri Sep 25 2026 .KEY MESSAGES... - Warmer and drier conditions return for the weekend. - Another push of moisture will arrive by Monday, bringing widespread moderate to heavy precipitation through midweek. && .DISCUSSION... Issued at 952 PM MDT Fri Sep 25 2026 PREDOMINATELY DRY THIS WEEKEN","url":"https://forecast.weather.gov/product.php?site=GJT&issuedby=GJT&product=AFD&format=CI"},"hwo":null,"fwf":{"office":"GJT","issued":"2026-09-25T18:43:00+00:00","snippet":".DISCUSSION... Scattered showers and thunderstorms will be around this afternoon, especially along and south of I-70. Most of eastern Utah and northwest Colorado will remain on the drier side of things. Saturday and Sunday will be mostly dry with a return to unsettled weather next week. Fire weather concerns remain low at this time. ...GUSTY ERRATIC WINDS CAN BE EXPECTED NEAR ANY SHOWERS OR THUNDE","url":"https://forecast.weather.gov/product.php?site=GJT&issuedby=GJT&product=FWF&format=CI"},"coagmet":{"station_id":"gun01","station_name":"Gunnison","distance_km":29.5,"soil_temp_5cm_f":54.79,"soil_temp_15cm_f":56.79,"soil_moisture_5cm":null,"soil_moisture_15cm":null,"precip_in":null,"eto_in":null,"vapor_pressure":null,"solar_radiation":0.2,"wind_speed_mph":0.1,"air_temp_f":42.85,"relative_humidity":0.915,"url":"https://coagmet.colostate.edu/station/gun01"},"aviation":{"icao":"KGUC","distance_km":0,"raw_metar":"METAR KGUC 260456Z AUTO 02003KT 10SM CLR 08/07 A3031 RMK AO2 SLP211 T00830067 $","temp_f":47,"wind_dir":20,"wind_kt":3,"gust_kt":null,"visibility":"10+","cover":"CLR","flight_category":"VFR","altimeter":1026.5,"observed":1790398560,"raw_taf":"TAF KGUC 260520Z 2606/2706 02003KT P6SM SKC FM262000 22007KT P6SM SCT250 FM270000 31005KT P6SM BKN250","url":"https://aviationweather.gov/data/metar/?ids=KGUC&hours=0"},"airgradient":null,"airnow":{"aqi":23,"category":"Good","parameter":"PM2.5","reporting_area":"Aspen","observed":"2026-09-25 22","by_parameter":{"PM2.5":{"aqi":23,"category":"Good","reporting_area":"Aspen","observed":"2026-09-25 22"},"PM10":{"aqi":11,"category":"Good","reporting_area":"Aspen","observed":"2026-09-25 22"}},"url":"https://www.airnow.gov/","distance_km":7.8},"openmeteo_aq":{"pm25":1.5,"pm10":2,"co":105,"no2":3.5,"so2":0.2,"o3":72,"european_aqi":26,"us_aqi":39,"time":"2026-09-25T23:00"},"usgs":{"station_id":"09111250","station_name":"COAL CREEK ABV MCCORMICK DTCH AT CRESTED BUTTE, CO","distance_km":0.3,"discharge_cfs":5.13,"gauge_height_ft":4.21,"water_temp_f":null,"observed":"2026-