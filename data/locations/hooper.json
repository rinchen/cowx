5bcb081f0abe71d2d734d.001.1","url":"https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.ede8c3675e6d454b5455bcb081f0abe71d2d734d.001.1"},{"event":"Flood Warning","headline":"Flood Warning issued October 24 at 5:29PM MDT until October 25 at 9:45PM MDT by NWS Pueblo CO","description":"* WHAT...Flooding likely along the Rio Grande between Monte Vista and\nAlamosa.\n\n* WHERE...Southeastern Rio Grande County and West Central Alamosa\nCounty...\n\n* WHEN...Until 945 PM MDT Sunday.\n\n* IMPACTS...Flooding along the Rio Grande and low lying agricultural\nareas in Rio Grande and Alamosa counties is occurring.\n\n* ADDITIONAL DETAILS...\n- At 525 PM MDT, Emergency management reports flooding of low lying\nareas along and near the Rio Grande in Rio Grande county and in\nAlamosa county upstream of the city of Alamosa.\n- Some locations that will experience flooding include...\nMainly rural areas of Southeastern Rio Grande and West Central\nAlamosa Counties between Monte Vista and Alamosa.\n- http://www.weather.gov/safety/flood","ends":"2026-10-25T21:45:00-06:00","severity":"Severe","areaDesc":"Alamosa, CO; Rio Grande, CO","id":"urn:oid:2.49.0.1.840.0.dec66dcc50c62eb3136a29e188c17eb9595591f1.001.1","url":"https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.dec66dcc50c62eb3136a29e188c17eb9595591f1.001.1"}],"afd":{"office":"PUB","issued":"2026-10-25T05:13:00+00:00","snippet":"000 FXUS65 KPUB 250513 AFDPUB Area Forecast Discussion National Weather Service Pueblo CO 1113 PM MDT Sat Oct 24 2026 .KEY MESSAGES... - Heavy rain likely to occur over parts of the southeast plains this afternoon into tonight. - Low lying agricultural flooding in the western side of the San Luis Valley likely for the next day or two. - dry weather through next week. - Another impactful storm poss","url":"https://forecast.weather.gov/product.php?site=PUB&issuedby=PUB&product=AFD&format=CI"},"hwo":{"office":"PUB","issued":"2026-10-24T17:20:00+00:00","snippet":"000 FLUS45 KPUB 241720 HWOPUB Hazardous Weath