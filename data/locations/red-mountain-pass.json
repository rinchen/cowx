46,0.224,0.158,0.083,0.19,0.188,0.243,0.256,0.283,0.26,0.288,0.269,0.097,0.15,0.105,0.089,0.069,0.079,0.171,0.106,0.123,0.065,0.057,0.069,0.154,0.082,0.154,0.151,0.09,0.094,0.139,0.104,0.062,0.066,0.088,0.059,0.048,0.073,0.093,0.108,0.073,0.115,0.063,0.111,0.172,0.152,0.114,0.08,0.055,0.111,0.077,0.039,0.113,0.052,0.074,0.073,0.066,0.152,0.095,0.021,0.025,0.019,0.071,0.06,0.098,0.045,0.06,0.077,0.091,0.09,0.065,0.119,0.101,0.049,0.121,0.122,0.074,0.044,0.04,0.046,0.02,0.009,0.054,0.039,0.039,0.047,0.105,0.075,0.036,0.032,0.12,0.07,0.024,0.09,0.056,0.059,0.057,0.028,0.059,0.04,0.073,0.082,0.007,0.075,0.063,0.133,0.075,0.045,0.059,0.077,0.083,0.069,0.075,0.063,0.013,0.002,0.04,0.118,0.117,0.101,0.073,0.052,0.076,0.079,0.1,0.087,0.078,0.089,0.033,0.051,0.063,0.049,0.032,0.113,0.153,0.028,0.05,0.064,0.1,0.105,0.112,0.099,0.082,0.097,0.062,0.077,0.041,0.087,0.134,0.057,0.056,0.104,0.072,0.051,0.043,0.116,0.072,0.05]}},"alerts":[{"event":"Hydrologic Outlook","headline":"Hydrologic Outlook issued September 25 at 2:21PM MDT by NWS Grand Junction CO","description":"ESFGJT\n\nIn the wake of today's precipitation, our attention will turn to the\nEastern Pacific. Tropical moisture is anticipated to spread across\nthe Desert Southwest early next week, drawing moisture from a pair of\nHurricanes; Odalys and Polo. The forecast becomes increasing complex\ndue to a closed low currently forecast to drive across the Southwest\nCONUS as Hurricane Polo approaches the Baja California Peninsula.\nStrong southerly winds ahead of the low are expected to pull tropical\nmoisture towards eastern Utah and western Colorado as early as Monday\nmorning. The challenge and uncertainty in our precipitation forecast\nincrease as the week progresses and the low traverses our southern\nStates. Excessive rainfall is most probable over AZ and NM, attm, but\nthe northerly extent poses a threat to our southern San Juan river\nbasins. Current forecasts suggests 1 to 3 inches of rain over Monday\nmorning through Wednesday. At face value, rivers and tributaries will\nsee a bump up due to said moisture. However, localized heavier\namounts could result in minor flooding across the southern San Juan\nfoothills and communities further downstream.\n\nRivers have responded rapidly to recent rainfall due to saturated\nsoils and increased runoff potential. Thus, prolonged periods of\nadditional rainfall over these regions would trigger a similar\nresponse. The current precipitation forecast suggests larger peaks in\nseveral creeks and rivers than what has been observed over the\nprevious 7 days. However, high end probabilistic rainfall amounts\n(i.e. above 90th percentile) may lead to rivers exceeding action\nstage to minor flooding. Most probable basins to see significant\nrises include; the Rio Blanco, San Juan, Piedra, Los Pinos/Vallecito\nCreek, and the Animas River Basins.\n\nConvective storms and periods of heavy rainfall fed from said\ntropical moisture could result in localized flooding impacts across\nthe CWA, however, confidence decreases rapidly north of the San\nJuans. Please continue to monitor the forecast as these systems\nevolve. Especially for those who reside and/or plan to recreate in\nthe southwest quadrant of the forecast area.","ends":"2026-09-30T06:00:00-06:00","severity":"Unknown","areaDesc":"Archuleta, CO; Dolores, CO; Gunnison, CO; Hinsdale, CO; La Plata, CO; Montezuma, CO; Ouray, CO; San Juan, CO; San Miguel, CO; Grand, UT; San Juan, UT","id":"urn:oid:2.49.0.1.840.0.ce67801ec73048f07c44dd0418c6a50edd1c8fdc.001.1","url":"https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.ce67801ec73048f07c44dd0418c6a50edd1c8fdc.001.1"}],"afd":{"office":"GJT","issued":"2026-09-27T04:57:00+00:00","snippet":"000 FXUS65 KGJT 270457 AFDGJT Area Forecast Discussion National Weather Service Grand Junction CO 1057 PM MDT Sat Sep 26 2026 .KEY MESSAGES... - Warmer and drier conditions continue Sunday. - Another push of moisture will arrive by Monday, bringing widespread moderate to heavy precipitation through midweek. - Drier conditions return late week. && .DISCUSSION... Issued at 1029 PM MDT Sat Sep 26 202","url":"https://forecast.weather.gov/product.php?site=GJT&issuedby=GJT&product=AFD&format=CI"},"hwo":null,"fwf":{"office":"GJT","issued":"2026-09-26T19:20:00+00:00","snippet":".DISCUSSION...There are a few isolated thunderstorms across the region over the higher terrain this afternoon, but otherwise expect mostly quiet conditions today and tomorrow with temperatures near normal to five degrees above normal. Cooler wet weather moves into the region Monday through mid week and dries out for the end of the week. Critical fire weather conditions are not expected. ...GUSTY E","url":"https://forecast.weather.gov/product.php?site=GJT&issuedby=GJT&product=FWF&format=CI"},"coagmet":{"station_id":"rgw01","station_name":"Ridgway","distance_km":31.1,"soil_temp_5cm_f":56.57,"soil_temp_15cm_f":58.62,"soil_moisture_5cm":null,"soil_moisture_15cm":null,"precip_in":null,"eto_in":null,"vapor_pressure":null,"solar_radiation":0.05,"wind_speed_mph":4.01,"air_temp_f":48.72,"relative_humidity":0.838,"url":"https://coagmet.colostate.edu/station/rgw01"},"aviation":{"icao":"KTEX","distance_km":18.7,"raw_metar":"METAR KTEX 270515Z AUTO 14006KT 10SM CLR 08/05 A3045 RMK AO2","temp_f":46,"wind_dir":140,"wind_kt":6,"gust_kt":null,"visibility":"10+","cover":"CLR","flight_category":"VFR","altimeter":1031.2,"observed":1790486100,"raw_taf":"TAF KTEX 262320Z 2700/2724 27005KT P6SM SCT045 BKN150 FM270200 14005KT P6SM FEW250 FM271800 20007KT P6SM BKN250","url":"https://aviationweather.gov/data/metar/?ids=KTEX&hours=0"},"airgradient":null,"airnow":{"aqi":22,"category":"Good","parameter":"PM2.5","reporting_area":"Telluride","observed":"2026-09-26 22","by_parameter":{"PM2.5":{"aqi":22,"category":"Good","reporting_area":"Telluride","observed":"2026-09-26 22"},"PM10":{"aqi":16,"category":"Good","reporting_area":"Telluride","observed":"2026-09-26 22"}},"url":"https://www.airnow