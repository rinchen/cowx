19f66ec0b1d0c24e802afcf.001.1"},{"event":"Hydrologic Outlook","headline":"Hydrologic Outlook issued October 9 at 10:53AM MDT by NWS Grand Junction CO","description":"ESFGJT\n\nA strong low pressure system off the Pacific Coast will begin to draw\nin tropical moisture associated with Topical Storm Rachel this\nweekend. This strong southerly fetch will draw anomalously high\nmoisture content across the Desert Southwest and into eastern Utah\nand western Colorado. The chance for widespread precipitation\nincreases Saturday evening into Sunday. Total precipitation forecasts\nrange from 1 to 3 inches across high terrain, with highest amounts\nfavoring the Uintas, Tavaputs and the Southwest San Juan mountains.\n\nEmbedded thunderstorms are also possible Sunday afternoon, increasing\nthe threat for flash flooding across vulnerable terrain. While\nconfidence in location and rainfall rates remain low at this time,\nthe potential for rapidly rising rivers, streams, normally dry\narroyos and slot canyons are possible Sunday through Monday.\n\nPlease follow the evolving forecast, especially if your plans\nincluding recreating or commuting across eastern Utah and western\nColorado Sunday onward. Also, keep in mind weather potential above\nyour location and upstream, particularly for those who reside below\nsensitive terrain like recent burn scars.","ends":"2026-10-12T18:00:00-06:00","severity":"Unknown","areaDesc":"Archuleta, CO; Delta, CO; Dolores, CO; Garfield, CO; Hinsdale, CO; La Plata, CO; Mesa, CO; Moffat, CO; Montezuma, CO; Montrose, CO; Ouray, CO; Rio Blanco, CO; San Juan, CO; San Miguel, CO; Daggett, UT; Grand, UT; San Juan, UT; Uintah, UT","id":"urn:oid:2.49.0.1.840.0.5953c0ab1d0bcab0b29fc3e9364e3d17cf28daf6.001.1","url":"https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.5953c0ab1d0bcab0b29fc3e9364e3d17cf28daf6.001.1"}],"afd":{"office":"GJT","issued":"2026-10-11T11:55:00+00:00","snippet":"000 FXUS65 KGJT 111155 AFDGJT Area Forecast Discussion National Weather Service Grand Junction CO 555 AM MDT Sun Oct 11 2026 .KEY MESSAGES... - Deep moisture continues through the weekend as remnants of tropical system Rachel move through the region, especially overnight and through Sunday. Rainfall totals of 2-3 inches are possible over the eastern Utah mountains and 1-2 inches across the San Jua","url":"https://forecast.weather.gov/product.php?site=GJT&issuedby=GJT&product=AFD&format=CI"},"hwo":null,"fwf":{"office":"GJT","issued":"2026-10-11T09:00:00+00:00","snippet":".DISCUSSION... Widespread wetting rains will continue across the region today, as extra-tropical moisture moves across the region. Some strong thunderstorms are expected to develop with damaging winds, hail, and heavy rainfall. Flash flooding remains a concern around sensitive terrain. Winds will increase appreciably today, gusting to around 45 mph across much of eastern UT and western CO. Critica","url":"https://forecast.weather.gov/product.php?site=GJT&issuedby=GJT&product=FWF&format=CI"},"coagmet":null,"aviation":null,"airgradient":null,"airnow":null,"openmeteo_aq":{"pm25":3.4,"pm10":4.3,"co":106,"no2":1.1,"so2":0.2,"o3":76,"european_aqi":28,"us_aqi":32,"time":"2026-10-11T10:00"},"usgs":null,"snotel":null,"cdot_camera":{"id":"969","name":"US 40 MP 040.35 WB at Elk Spings Ranch","lat":40.37032,"lon":-108.389,"distance_km":50.1,"imageUrl":null,"pageUrl":"https://maps.cotrip.org/?lat=40.37032&lon=-108.389&zoom=12"},"cdot_rwis":null,"cdot_roads":{"updatedAt":"2026-10-11T16:09:56.423Z","alerts":[],"cameras":[{"id":"969","name":"US 40 MP 040.35 WB at Elk Spings Ranch","lat":40.37032,"lon":-108.389,"distance_km":50.1,"imageUrl":null,"pageUrl":"https://maps.cotrip.org/?lat=40.37032&lon=-108.389&zoom=12"}],"links":{"cotrip":"https://maps.cotrip.org"},"rwis":null,"road_condition":{"id":"198","name":"US 40, between the Utah Border (near Dinosaur) and Barclay Street (Craig)","routeName":"US 40","lat":40.273339381422375,"lon":-109.05101711367836,"condition":"dry","forecast_text":"Chanc