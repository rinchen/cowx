ight so motorists should plan for potential delays, Monday-Saturday. Please allow extra time to get through the work zone. Safety benefits of this work includes pedestrian safety upgrades and ADA accessibility improvements. Expect lane shifts and up to 15-minute delays. Crews will switch two-way traffic into the eastbound lanes, perform temporary striping operations and begin asphalt milling in the westbound lanes. Parking will not be permitted on US 160 and vehicles will be towed at the owner's expense. Westbound lane closures, 10’ width and 75’ length restrictions will remain in place 24/7 through end of 2026. Work is weather-dependent. For questions contact the project team at 970-335-9230 or Pagosa160reconstruction@gmail.com Project Webpage: www.codot.gov/projects/us160pagosasprings","impact":null,"roads":"US-160W","lat":37.272958,"lon":-107.036952,"chain_law":false,"closure":false,"pass_relevant":false,"observed":"2026-10-21T13:03:24.427Z","start_time":"2026-10-29T13:00:00Z","clear_time":"2026-10-30T00:00:00Z","category":"Construction","severity":null,"source":"planned","geometry_kind":"point","distance_km":2.4}]},"cwop":{"callsign":"KC0OOO-WX","lat":37.265167,"lon":-107.029667,"temp_f":29,"humidity":86,"pressure_mb":1026.1,"wind_speed_mph":0,"wind_gust_mph":2,"wind_dir_deg":271,"observed":"2026-10-29T11:18:25Z","distance_km":1.8},"pws":{"primary":{"callsign":"KC0OOO-WX","network":"CWOP/APRS","lat":37.265167,"lon":-107.029667,"temp_f":29,"humidity":86,"pressure_mb":1026.1,"wind_speed_mph":0,"wind_gust_mph":2,"wind_dir_deg":271,"observed":"2026-10-29T11:18:25Z","distance_km":1.8},"nearby":[],"links":{"aprs":"https://aprs.fi/#!call=a%2FKC0OOO-WX","wunderground":null}},"hms_smoke":{"density":"none","observed":"2026-10-29","sourceUrl":"https://satepsanone.nesdis.noaa.gov/pub/FIRE/web/HMS/Smoke_Polygons/Shapefile/2026/10/hms_smoke20261029.zip"},"fire_weather":{"day1":{"windRh":"none","dryT":"none","valid":"2026-10-29T12:00:00+00:00","expire":"2026-10-30T12:00:00+00: