{
  "name": "cowx",
  "version": "0.1.0",
  "description": "COWX — Colorado Weather: aggregated air quality and weather data",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "fetch:data": "node scripts/fetch/index.js",
    "fetch:climatology": "node scripts/fetch/climatology-only.js",
    "test": "TZ=UTC node --test tests/*.test.js",
    "test:coverage": "TZ=UTC node --experimental-test-coverage --test tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "validate:locations": "node scripts/validate-locations.js",
    "validate:schemas": "node scripts/validate-schemas.js",
    "build:co-zips": "node scripts/locations/build-co-zips.js",
    "update": "pnpm update && pnpm dedupe",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6"
  },
  "packageManager": "pnpm@10.34.3",
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.5"
    }
  },
  "dependencies": {
    "undici": "^8.10.0"
  }
}
